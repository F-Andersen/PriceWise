# Copy to .env on the server (next to docker-compose.yml) and fill in.
# .env is git-ignored: never commit real secrets.

# Domain for automatic HTTPS (DNS A record must point to this server),
# or ":80" to serve plain HTTP by IP while you have no domain.
SITE_ADDRESS=:80

# Database password. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# Login token signing key, at least 32 characters. Generate: openssl rand -hex 32
# Changing it logs every user out.
JWT_SECRET=

# Emails allowed to change the catalogue through the API (comma-separated). Optional.
ADMIN_EMAILS=

# Other websites allowed to call the API from a browser (comma-separated origins).
# Leave empty: the web app is served from the same address, native apps need no CORS.
CORS_ORIGIN=

# Price collection: times of day (TZ below), comma-separated, and history retention.
PRICE_SYNC_ENABLED=true
PRICE_SYNC_TIME=06:00
PRICE_HISTORY_DAYS=730
TZ=Europe/Kyiv

# true prefills demo@example.com / password123 on the login screen (for a demo only).
DEMO_LOGIN=false
