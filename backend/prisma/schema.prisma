generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  /// Raised on every password change; tokens issued earlier stop working.
  tokenVersion  Int            @default(0)
  createdAt     DateTime       @default(now())
  shoppingLists ShoppingList[]
  passwordReset PasswordReset?
}

/// The one pending "forgot password" code of a user.
model PasswordReset {
  userId    String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Store {
  id        String  @id @default(cuid())
  name      String
  logoUrl   String?
  city      String
  sourceUrl String?
  prices    Price[]
  sources   ProductSource[]
}

model Product {
  id          String             @id @default(cuid())
  name        String
  brand       String
  category    String
  barcode     String             @unique
  unit        String
  volume      String
  imageUrl    String?
  description String?
  prices      Price[]
  sources     ProductSource[]
  listItems   ShoppingListItem[]
  recipeItems RecipeItem[]
  matchesAsA  MatchCandidate[] @relation("MatchA")
  matchesAsB  MatchCandidate[] @relation("MatchB")

  @@index([name])
  @@index([brand])
  @@index([category])
}

model ProductSource {
  id        String  @id @default(cuid())
  productId String
  storeId   String
  sourceUrl String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([storeId])
}

model Price {
  id            String   @id @default(cuid())
  productId     String
  storeId       String
  price         Decimal  @db.Decimal(10, 2)
  oldPrice      Decimal? @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  /// Last day the discount is valid (end of day, Kyiv time), if the store published it.
  promoEndsAt   DateTime?
  /// When this price was first seen. A row covers the period until lastSeenAt:
  /// collections that find the same price only move lastSeenAt forward.
  dateCollected DateTime
  /// Last collection that confirmed this exact price and availability.
  lastSeenAt    DateTime
  isAvailable   Boolean  @default(true)
  imageUrl      String?
  sourceUrl     String?
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId, storeId, dateCollected])
  @@index([lastSeenAt])
}

/// Two products that may be the same item, waiting for a person's decision.
model MatchCandidate {
  id         String    @id @default(cuid())
  productAId String
  productBId String
  /// 0-100: how close the names are.
  score      Int
  /// same_name or similar_name
  reason     String
  /// pending or rejected. An approved pair is merged, which removes this row.
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  productA   Product   @relation("MatchA", fields: [productAId], references: [id], onDelete: Cascade)
  productB   Product   @relation("MatchB", fields: [productBId], references: [id], onDelete: Cascade)

  @@unique([productAId, productBId])
  @@index([status, score])
}

/// One price collection run: how it went and what could not be read.
model CollectionRun {
  id              String    @id @default(cuid())
  /// manual, scheduled or catch-up
  trigger         String
  /// running, success, partial, failed or interrupted
  status          String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  productsChecked Int       @default(0)
  pricesRecorded  Int       @default(0)
  issuesCount     Int       @default(0)
  /// Per-store counts from the run's summary.
  stores          Json?
  /// Pages or products that failed, capped so a bad run stays small.
  issues          Json?
  error           String?

  @@index([startedAt])
}

model ShoppingList {
  id        String             @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]
}

model ShoppingListItem {
  id             String       @id @default(cuid())
  shoppingListId String
  productId      String
  quantity       Int          @default(1)
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shoppingListId, productId])
}

model Recipe {
  id              String       @id @default(cuid())
  /// Stable key of a starter recipe; recipes added directly in the database may omit it
  slug            String?      @unique
  title           String
  description     String
  imageUrl        String?
  durationMinutes Int          @default(15)
  servings        Int          @default(2)
  difficulty      String       @default("Легко")
  steps           String[]     @default([])
  items           RecipeItem[]
}

model RecipeItem {
  id           String   @id @default(cuid())
  recipeId     String
  /// Current best match from the catalogue; null while none is on sale
  productId    String?
  name         String
  /// Needed for Recipe.servings, in grams, millilitres or pieces
  amount       Float
  unit         String
  optional     Boolean  @default(false)
  position     Int      @default(0)
  categories   String[] @default([])
  /// A product name must start with one of these
  includeTerms String[] @default([])
  excludeTerms String[] @default([])
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}
