{
  "name": "price-monitoring-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "monitor:prices": "tsx src/modules/priceMonitoring/runPriceCollection.ts",
    "catalog:merge-fresh": "tsx src/modules/priceMonitoring/runFreshMerge.ts",
    "seed": "tsx prisma/seed.ts",
    "start:prod": "prisma migrate deploy && node dist/src/index.js",
    "monitor:prices:prod": "node dist/src/modules/priceMonitoring/runPriceCollection.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "monitor:runs": "tsx src/modules/priceMonitoring/runCollectionLog.ts",
    "monitor:runs:prod": "node dist/src/modules/priceMonitoring/runCollectionLog.js",
    "matches": "tsx src/modules/priceMonitoring/runMatchReview.ts",
    "matches:prod": "node dist/src/modules/priceMonitoring/runMatchReview.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
