DATABASE_URL="postgresql://postgres:postgres@localhost:5433/price_monitoring?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4001
CORS_ORIGIN="*"

# Price collection inside the API (server local time, comma-separated times).
# Set PRICE_SYNC_ENABLED to "false" to disable.
PRICE_SYNC_ENABLED=true
PRICE_SYNC_TIME="06:00"
# Ended price periods older than this many days are deleted after each collection
# (the latest price of every product/store is always kept). 0 keeps everything.
PRICE_HISTORY_DAYS=730
# Pause before re-reading a page whose price changed by more than 15%, in ms (default 180000).
# PRICE_RECHECK_DELAY_MS=180000
# Hours a price stays confirmed after the last collection that saw it (default 72).
# PRICE_MAX_AGE_HOURS=72
