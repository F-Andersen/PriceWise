DATABASE_URL="postgresql://postgres:postgres@localhost:5433/price_monitoring?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4001
CORS_ORIGIN="*"

# Daily price collection inside the API (server local time). Set to "false" to disable.
PRICE_SYNC_ENABLED=true
PRICE_SYNC_TIME="06:00"
