#!/usr/bin/env bash
# Install as root:root 0755 at /usr/local/libexec/pricewise-ssh-gate.
set -euo pipefail

request=${SSH_ORIGINAL_COMMAND-}
if [[ $request =~ ^deploy:([0-9a-f]{40})$ ]]; then
  target_sha=${BASH_REMATCH[1]}
else
  echo 'Only deploy:<main-commit-sha> is accepted.' >&2
  exit 64
fi

exec sudo -n /usr/local/sbin/pricewise-deploy <<< "$target_sha"
